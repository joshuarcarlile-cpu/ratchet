# Shell scripts and Python must keep LF regardless of the checkout platform:
# a `#!/usr/bin/env bash` line ending in CRLF fails on Linux with
# "bad interpreter: No such file or directory".
* text=auto eol=lf

# PowerShell is the exception - it is Windows-only here and expects CRLF.
*.ps1 text eol=crlf

*.jsonl text eol=lf
